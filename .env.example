# Copie para .env e preencha. O .env NÃO é versionado.

# --- Hugging Face (opcional: só para baixar o dataset gated de teste, se o acesso for liberado)
HF_TOKEN=

# --- Juiz do avaliador oficial da VAKRA (obrigatório para ter score local)
# O avaliador usa openai/gpt-oss-120b via Groq (JUDGE_BACKEND=groq) ou RITS (só IBM).
JUDGE_BACKEND=groq
API_KEY=            # chave da Groq

# --- Onde o agente oficial encontra o Lumi (servido via vLLM, endpoint OpenAI-compatível)
# Direto no vLLM:        http://localhost:8000/v1
# Via proxy de gravação: http://localhost:8001/v1   (make proxy)
LUMI_BASE_URL=http://localhost:8001/v1
